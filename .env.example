# RAG Document Intelligence — Environment Configuration
# Copy this file to .env and adjust as needed.

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# Supported providers:
#   mock   — deterministic, no external service (for testing)
#   ollama — local LLM via Ollama HTTP API
LLM_PROVIDER=ollama

# Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120

# ---------------------------------------------------------------------------
# Embedding configuration
# ---------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Vector database
# ---------------------------------------------------------------------------
COLLECTION_NAME=pdf_documents

# ---------------------------------------------------------------------------
# Chunking configuration
# ---------------------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ---------------------------------------------------------------------------
# Retrieval configuration
# ---------------------------------------------------------------------------
# ChromaDB returns L2 distances (lower = more similar).
# SCORE_THRESHOLD sets the maximum distance to retain; results with
# distance > threshold are filtered out.
# 1.0 is a reasonable default for all-MiniLM-L6-v2 embeddings.
SCORE_THRESHOLD=1.0

# Maximum number of characters allowed in a user query.
MAX_QUERY_LENGTH=2000

# ---------------------------------------------------------------------------
# Default retrieval settings
# ---------------------------------------------------------------------------
DEFAULT_TOP_K=5

# ---------------------------------------------------------------------------
# Patient context configuration
# ---------------------------------------------------------------------------
# Provider for patient-specific context. Supported values:
#   local   — loads synthetic dev fixtures from data/patients/<id>.json
#   none    — no patient context (pure knowledge-mode RAG)
#   backend — adapter for the future SoleusAI backend (not yet implemented)
PATIENT_CONTEXT_PROVIDER=local

# Directory for local patient JSON fixtures (used by "local" provider)
PATIENT_DATA_DIR=data/patients

# ---------------------------------------------------------------------------
# Knowledge directory
# ---------------------------------------------------------------------------
# Base directory for organized knowledge materials.
# Subdirectories: soleus/, rehabilitation/, exercise_science/, biomechanics/,
# emg/, diabetes/, safety/, device/
KNOWLEDGE_DIR=knowledge
